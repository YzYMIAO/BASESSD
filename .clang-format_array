---
# 配置适用版本：clang-format 14.x
# 已验证版本：Ubuntu clang-format 14.0.0
# 更换 clang-format 主版本后，应先执行 make format-check 验证配置兼容性。

Language: Cpp
BasedOnStyle: Google

# 缩进
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never

# 关键修改 1：不自动换行，完全由源码手动控制
ColumnLimit: 0

# 指针风格
DerivePointerAlignment: false
PointerAlignment: Right

# 空格
SpaceBeforeParens: ControlStatements

# 不允许把函数、控制语句、块压缩到一行
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# switch case 缩进
IndentCaseLabels: true
IndentCaseBlocks: false
IndentGotoLabels: false

# 大括号风格：Allman
BreakBeforeBraces: Allman

# 关键修改 2：禁止参数打包到一行，保持“一个参数一行”的潜力
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true

# 长表达式换行
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
AlignOperands: Align

# 关键修改 3：结构体数组元素按字段纵向对齐
AlignArrayOfStructures: Right

# 连续声明、赋值、宏、位域对齐
AlignConsecutiveDeclarations: true
AlignConsecutiveAssignments: true
AlignConsecutiveMacros: true
AlignConsecutiveBitFields: true

# 反斜杠对齐
AlignEscapedNewlines: Right

# 注释
SpacesBeforeTrailingComments: 1

# 初始化列表
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false
SpacesInContainerLiterals: false

# 类型转换
SpacesInCStyleCastParentheses: false
SpaceAfterCStyleCast: false

# 数组下标
SpacesInSquareBrackets: false

# 预处理指令
IndentPPDirectives: AfterHash
PPIndentWidth: 4

# include 排序
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
IncludeCategories:
  - Regex: '^".*"'
    Priority: 1
  - Regex: '^<(common|controller|flash_controller|ftl|host|nand|platform)/'
    Priority: 2
  - Regex: '^<'
    Priority: 3

# 空行控制
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# 注释处理
ReflowComments: true
SpacesInLineCommentPrefix:
  Minimum: 1
  Maximum: -1

# 字符串
AlwaysBreakBeforeMultilineStrings: false

# enum
AllowShortEnumsOnASingleLine: false

# namespace
NamespaceIndentation: None
---
