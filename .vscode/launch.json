{
  "version": "0.2.0",
  "configurations": [
    {
      // 命名规则：<用途> · <镜像> · <JLink 起法>
      //   用途  UT/调试 = 烧完停在 main，可打断点、可看源码（需要源码符号）
      //         烧录     = 只 load + reset，不提供源码级调试（release 已剥符号）
      //   镜像  debug   = build/firmware/debug/bin/debug.elf   ← `make all` / `make tests`
      //         release = build/firmware/release/bin/release.elf ← `make release`
      //         ⚠ 同一路径只保留**最后一条构建**：跑全量 UT 前先 `make tests`。
      //   JLink 外部    = 你自己先起 JLinkGDBServer（监听 2331），这里只连
      //         WSL自启 = VS Code 通过 serverpath 拉起 Windows 的 JLinkGDBServer
      "name": "① UT/调试 · debug 镜像 · 外部 JLink 2331",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",

      "device": "STM32H743II",

      "gdbTarget": "localhost:2331",

      // debug 镜像 = `make all`（产品）或 `make tests`（全量 UT，FC + FTL 全编入），
      // -O0、ASSERT 生效、有完整源码符号 ⇒ 可打断点。
      // **同一路径只保留最后一条构建**：跑 UT 前务必 `make tests` 重新生成一次。
      "executable": "${workspaceFolder}/build/firmware/debug/bin/debug.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",

      "runToEntryPoint": "main",

      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],

      "postLaunchCommands": [
        "monitor halt"
      ],

      "svdFile": "${workspaceFolder}/STM32H743xI.svd",

      "armToolchainPath": "/usr/bin"
    },
    {
      "name": "② UT/调试 · debug 镜像 · WSL 自启 JLink",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",

      "device": "STM32H743II",
      "interface": "swd",
      "serialNumber": "602717758",

      // debug 镜像 = `make all`（产品）或 `make tests`（全量 UT，FC + FTL 全编入），
      // -O0、ASSERT 生效、有完整源码符号 ⇒ 可打断点。
      // **同一路径只保留最后一条构建**：跑 UT 前务必 `make tests` 重新生成一次。
      "executable": "${workspaceFolder}/build/firmware/debug/bin/debug.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",
      "armToolchainPath": "/usr/bin",
      "serverpath": "D:/StudyTool/Develop/JLink_V972/JLinkGDBServer.exe",

      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32H743xI.svd"
    }
,
    // ─────────────────────────────────────────────────────────────────────
    // release 镜像专用：**只烧录**，不做源码级调试。
    // 原因：release 档链接带 `-s`（剥符号表）⇒ `runToEntryPoint: main` / 断点都不可用；
    // 但 cortex-debug 的 `load` 只依赖 program header，烧录本身没问题。
    // 用途：烧 `make release` 的产品固件，或 `make tests BUILD_TYPE=release` 的 UT 镜像
    //       （两者都落在同一路径 build/firmware/release/bin/release.elf，最后一条构建决定内容）。
    {
      "name": "③ 烧录 · release 镜像 · 外部 JLink 2331",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",

      "device": "STM32H743II",

      "gdbTarget": "localhost:2331",

      "executable": "${workspaceFolder}/build/firmware/release/bin/release.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",

      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],

      "postLaunchCommands": [
        "monitor halt"
      ],

      "svdFile": "${workspaceFolder}/STM32H743xI.svd",

      "armToolchainPath": "/usr/bin"
    },
    {
      "name": "④ 烧录 · release 镜像 · WSL 自启 JLink",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",

      "device": "STM32H743II",
      "interface": "swd",
      "serialNumber": "602717758",

      "executable": "${workspaceFolder}/build/firmware/release/bin/release.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",
      "armToolchainPath": "/usr/bin",
      "serverpath": "D:/StudyTool/Develop/JLink_V972/JLinkGDBServer.exe",

      "svdFile": "${workspaceFolder}/STM32H743xI.svd"
    }
  ]
}
