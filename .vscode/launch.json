{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32H7R3L8 (J-Link)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",

      "device": "STM32H7R3L8",
      "interface": "swd",
      "serialNumber": "602717758",

      "executable": "${workspaceFolder}/build/firmware/debug/bin/debug.elf",

      "serverpath": "D:/StudyTool/Develop/JLink_V972/JLinkGDBServerCL.exe",
      "gdbPath": "D:/StudyTool/ARM/bin/arm-none-eabi-gdb.exe",

      "runToEntryPoint": "main",
      "preLaunchCommands": [
        "set substitute-path /mnt/d/01_work_project/soft_ssd D:/01_work_project/soft_ssd"
      ]
    }
  ]
}
