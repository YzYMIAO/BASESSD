{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32H743II BCH-DTCM swap (WSL → Win JLink)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",

      "device": "STM32H743II",

      "gdbTarget": "localhost:2331",

      // UT 构建（make tests）产物在 debug/；普通 release 调试时改回下一行
      // "executable": "${workspaceFolder}/build/firmware/release/bin/release.elf",
      "executable": "${workspaceFolder}/build/firmware/debug/bin/debug.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",

      "runToEntryPoint": "main",

      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],

      "postLaunchCommands": [
        "monitor halt"
      ],

      "svdFile": "${workspaceFolder}/STM32H743xI.svd",

      "armToolchainPath": "/usr/bin"
    },
    {
      "name": "Debug STM32H743II BCH-DTCM swap (WSL-only JLink)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",

      "device": "STM32H743II",
      "interface": "swd",
      "serialNumber": "602717758",

      // UT 构建（make tests）产物在 debug/；普通 release 调试时改回下一行
      // "executable": "${workspaceFolder}/build/firmware/release/bin/release.elf",
      "executable": "${workspaceFolder}/build/firmware/debug/bin/debug.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",
      "armToolchainPath": "/usr/bin",
      "serverpath": "D:/StudyTool/Develop/JLink_V972/JLinkGDBServer.exe",

      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32H743xI.svd"
    }
  ]
}
