// ─────────────────────────────────────────────────────────────────────────────
// launch.json 模板：仓库内只保留与机器无关的 ${workspaceFolder} 路径。
// 所有配置都连**外部 JLink**：先跑 tools/debug_env.sh（或自行启动 JLinkGDBServer，
// 监听 2331），再按 F5。
// SVD 文件不在仓库内；需要外设视图时把 STM32H743xI.svd 放到工作区根，
// 并取消下方 "svdFile" 行的注释。
// ⚠ 个人序列号 / 本机绝对路径不要提交回仓库。
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": "0.2.0",
  "configurations": [
    {
      // 命名规则：<用途> · <产物>
      // 产物名由「构建档 + 是否编入 UT」决定：
      //   debug_ut   = `make tests UT=...`              debug -O2 + ASSERT + 符号
      //   debug      = `make all`                       debug -O2 + ASSERT + 符号（产品）
      //   release_ut = `make tests BUILD_TYPE=release UT=...`  release -O2 + NDEBUG（带 test 命令）
      //   release    = `make release`                   release -O2 + NDEBUG（产品，无 test 命令）
      // ⚠ -O0 只在排查汇编级/时序缺陷时临时用：`make tests DEBUG_OPT=-O0`
      "name": "① UT/逻辑调试 · debug_ut",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "device": "STM32H743II",
      "gdbTarget": "localhost:2331",
      "executable": "${workspaceFolder}/build/debug/bin/debug_ut.elf",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "runToEntryPoint": "main",
      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],
      // "svdFile": "${workspaceFolder}/STM32H743xI.svd",
      "armToolchainPath": "/usr/bin"
    },
    {
      // 产品调试：不带 UT 运行态，用于排查正式路径（USB / host I/O / FTL 后台）。
      "name": "② 产品调试 · debug",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "device": "STM32H743II",
      "gdbTarget": "localhost:2331",
      "executable": "${workspaceFolder}/build/debug/bin/debug.elf",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "runToEntryPoint": "main",
      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],
      // "svdFile": "${workspaceFolder}/STM32H743xI.svd",
      "armToolchainPath": "/usr/bin"
    },
    {
      // 发布/速度（UT）：带 test 命令，用于 /speed/ 与 release 全量 UT。
      // release 带 -s（剥符号），不能设 runToEntryPoint / 打断点；load 只依赖 program header。
      "name": "③ 发布/速度(UT) · release_ut",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "device": "STM32H743II",
      "gdbTarget": "localhost:2331",
      "executable": "${workspaceFolder}/build/release/bin/release_ut.elf",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],
      // "svdFile": "${workspaceFolder}/STM32H743xI.svd",
      "armToolchainPath": "/usr/bin"
    },
    {
      // 发布/产品：`make release` 产物，无 test 命令；用于正式板与 H2testw。
      "name": "④ 发布(产品) · release",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "device": "STM32H743II",
      "gdbTarget": "localhost:2331",
      "executable": "${workspaceFolder}/build/release/bin/release.elf",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],
      // "svdFile": "${workspaceFolder}/STM32H743xI.svd",
      "armToolchainPath": "/usr/bin"
    }
  ]
}
