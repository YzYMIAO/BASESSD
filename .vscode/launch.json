{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32H743II release (WSL → Win JLink)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",

      "device": "STM32H743II",

      "gdbTarget": "localhost:2331",

      "executable": "${workspaceFolder}/build/firmware/release/bin/release.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",

      "runToEntryPoint": "main",

      "preLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset"
      ],

      "postLaunchCommands": [
        "monitor halt"
      ],

      "svdFile": "${workspaceFolder}/STM32H743xI.svd",

      "armToolchainPath": "/usr/bin"
    },
    {
      "name": "Debug STM32H743II release (WSL-only JLink)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",

      "device": "STM32H743II",
      "interface": "swd",
      "serialNumber": "602717758",

      "executable": "${workspaceFolder}/build/firmware/release/bin/release.elf",

      "gdbPath": "/usr/bin/gdb-multiarch",
      "armToolchainPath": "/usr/bin",
      "serverpath": "D:/StudyTool/Develop/JLink_V972/JLinkGDBServer.exe",

      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32H743xI.svd"
    }
  ]
}
