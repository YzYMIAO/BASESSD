build/
*.log
# 板端测试原始日志是发布证据（README / 测试文档直接引用），按需纳入版本库
!docs/archive/test_logs/*.log

# Source Insight 工程目录（本机 IDE）
SI/

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# ============================================================================
# OS-specific & IDE config (不在 Git 中追踪，避免不同操作系统的路径冲突)
# ============================================================================

# compile_commands.json（含绝对路径，不同机器不同）
compile_commands.json

# Windows 特定的缩略图缓存
Thumbs.db
ehthumbs.db

# Windows 文件夹配置
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# WSL 与 Windows 互操作产生的文件
*.Zone.Identifier

# 调试临时文件
tools/flash.jlink

# IO 路线代码评审的登记清单（工作草稿，不进版本库）
.claude/io_review_backlog.md

# 全面人工审查的工作状态（断点 / 覆盖 / 收件箱，临时草稿，不进版本库）
.claude/review/

# 第三方 skill 学习样本（来源 / 许可证见目录内 README；本地参考，不随仓库分发）
.claude/skill-collection/examples/vendor/

# ============================================================================
# 本机工具 / 编辑器状态（不属于仓库内容）
# ============================================================================

# Claude Code 本机权限设置（含本机命令白名单）
.claude/settings.local.json

# 本机调试环境变量（可设置 JLINK_EXE 等；见 tools/debug_env.sh）
.debug_env.local

# 按 .vscode/launch.json 提示放在工作区根的 SVD 文件
*.svd

# Python 工具缓存（tools/*.py）
__pycache__/
*.pyc
.pytest_cache/

# 编辑器临时文件
.idea/
*.swp
*.swo
*.orig
*.rej
