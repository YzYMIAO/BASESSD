@echo off
chcp 65001 >nul
:: ============================================
:: 目录结构查看器
:: 功能：列出当前目录及子目录的所有文件和文件夹
:: ============================================

:: 设置标题
title 目录结构查看器

:: 获取当前目录的绝对路径
set "CURRENT_DIR=%cd%"
echo ============================================
echo 当前目录: %CURRENT_DIR%
echo ============================================
echo.

:: ============================================
:: 方法1：简单版 - 树形结构（仅文件夹）
:: ============================================
::echo [方法1] 目录树结构（仅显示文件夹）：
::echo ----------------------------------------
::tree /A
::echo.
::echo.

:: ============================================
:: 方法2：详细版 - 包含所有文件
:: ============================================
::echo [方法2] 完整目录树（包含所有文件）：
::echo ----------------------------------------
::tree /A /F
::echo.
::echo.

:: ============================================
:: 方法3：平铺列表 - 所有文件含完整路径
:: ============================================
::echo [方法3] 所有文件完整路径列表：
::echo ----------------------------------------
::dir /s /b /a-d
::echo.
::echo.

:: ============================================
:: 方法4：详细信息 - 含大小、日期、属性
:: ============================================
::echo [方法4] 详细文件信息（含大小、修改时间）：
::echo ----------------------------------------
::dir /s /a
::echo.
::
:: ============================================
:: 方法5：只列出文件（不含文件夹）
:: ============================================
::echo [方法5] 仅文件列表（递归所有子目录）：
::echo ----------------------------------------
::for /r %%i in (*) do echo %%~i
:: 参数说明：
:: /r  - 递归子目录
:: %%i - 每个文件的变量
:: %%~i - 去除引号的完整路径
::echo.

:: ============================================
:: 方法6：导出到文本文件
:: ============================================
set "OUTPUT_FILE=%CURRENT_DIR%\目录结构_%date:~0,4%%date:~5,2%%date:~8,2%_%time:~0,2%%time:~3,2%%time:~6,2%.txt"
set "OUTPUT_FILE=%OUTPUT_FILE: =0%"
echo [方法6] 导出目录结构到文件：
echo ----------------------------------------
echo 正在导出到: %OUTPUT_FILE%
tree /A /F > "%OUTPUT_FILE%"
echo 导出完成！
echo 文件位置: %OUTPUT_FILE%
echo.

:: ============================================
:: 方法7：统计信息
:: ============================================
echo [统计信息]：
echo ----------------------------------------
:: 统计文件夹数量（不包含当前目录）
for /f %%a in ('dir /s /b /ad ^| find /c /v ""') do set "FOLDER_COUNT=%%a"
echo 子文件夹数量: %FOLDER_COUNT%

:: 统计文件数量
for /f %%a in ('dir /s /b /a-d ^| find /c /v ""') do set "FILE_COUNT=%%a"
echo 文件总数量:   %FILE_COUNT%

:: 计算总大小
set "TOTAL_SIZE=0"
for /r %%i in (*) do set /a TOTAL_SIZE+=%%~zi 2>nul
echo 文件总大小:   %TOTAL_SIZE% 字节

echo.
echo ============================================
echo 查看完成！
echo ============================================

pause