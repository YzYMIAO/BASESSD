# ------------------------------------------------------------------------------
# 
# Generic Makefile
#
#
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Paths
# ------------------------------------------------------------------------------

#设备中存放可执行程序的路径和相关库路径
PATH_TOOLS_CC              = /usr/bin/
PATH_TOOLS_LIB             = /usr/lib/
PATH_TOOLS_UTIL            =

#源码与构建产物分离
#PATH_BIN	最终产物。存放编译链接生成的可执行文件
#PATH_TMP   临时文件根目录。作为所有中间文件的父目录，方便整体清理。
#PATH_NUL	通常定义为 Linux 的 /dev/null是一个“黑洞”设备。方便错误重定向
#PATH_OBJ	目标文件。存放编译生成的 .o 文件。
#PATH_LST	列表文件。存放 objdump 生成的反汇编列表文件（.lst），用于查看 C/C++ 对应的汇编指令。
#PATH_ERR	错误日志。存放编译时产生的警告和错误信息（.err），便于集中审查。
#PATH_PRE	预处理文件。存放预处理后的源码（.pre），用于调试宏定义和头文件包含。
#PATH_COV	覆盖率文件。存放用于代码覆盖率测试的 .o 文件及相关数据。
PATH_BIN                   = bin
PATH_TMP                   = tmp
PATH_NUL                   = /dev/null
PATH_OBJ                   = $(PATH_TMP)/obj
PATH_LST                   = $(PATH_TMP)/lst
PATH_ERR                   = $(PATH_TMP)/err
PATH_PRE                   = $(PATH_TMP)/pre
PATH_COV                   = $(PATH_TMP)/cov



# ------------------------------------------------------------------------------
# Application to build
# ------------------------------------------------------------------------------

APP = test_review


# -----------------------------------------------------------------------------
# Project file list
# Format is:
# FILES_PRJ  = file1                        \
#              foo/file2                    \
#              bar/file3
# -----------------------------------------------------------------------------

#参与构建的源文件列表，但它的写法比较特殊：它只列出了文件名（或相对于 Makefile 的路径），而没有写文件扩展名。
#修正：变量名从 PILES_PRJ 改为 FILES_PRJ
FILES_PRJ  = src/data_structure/ds_array        	\
			src/data_structure/ds_deque			\
			src/data_structure/ds_list			\
			src/data_structure/ds_pqueue		\
			src/data_structure/ds_queue			\
			src/data_structure/ds_rb_tree_table	\
			src/data_structure/ds_slist			\
			src/data_structure/ds_stack			\
			src/main/main


# ------------------------------------------------------------------------------
# Additional include files and compiler defines
# Format is:
# C_INCLUDES = -Iinclude_path1                 \
#              -Iinclude_path2                 \
#              -Iinclude_path3                 \
# ------------------------------------------------------------------------------

#修正：C_INCLUDES 需要包含 -I 前缀
C_INCLUDES  = -Iinclude                              \
              -Iinclude/data_structure


C_DEFINES	=



# ------------------------------------------------------------------------------
# The target name and location
# ------------------------------------------------------------------------------

TRG	= $(PATH_BIN)/$(APP)


# ------------------------------------------------------------------------------
# object files
# ------------------------------------------------------------------------------
FILES_TMP	= $(FILES_PRJ)
FILES_O		= $(addsuffix .o, $(FILES_TMP))

# ------------------------------------------------------------------------------
# VPATH definition
#
# VPATH is required for the maker to find the C-/ASM-Source files.
# ------------------------------------------------------------------------------

VPATH := $(sort $(dir $(FILES_TMP))) .


# ------------------------------------------------------------------------------
# Development tools
# ------------------------------------------------------------------------------
# PATH_TOOLS_CC        : 编译工具链（gcc、g++、ar、nm、objdump等）所在路径
# PATH_TOOLS_UTIL      : 辅助工具（echo、mkdir、rm、sed等）所在路径（空表示使用系统默认路径）
# 
# Core build tools:
# AR    : 归档工具，用于创建/修改静态库（.a文件）
# AS    : 汇编器，用于编译汇编代码（.s/.S文件）
# CC    : C/C++编译器，用于编译.c/.cpp源文件
# CL    : 链接器，用于将.o文件链接为可执行文件
# 
# Analysis and debug tools:
# NM        : 符号查看器，列出目标文件的符号表（函数名、全局变量等），用于分析内存布局
# GCOV      : 代码覆盖率测试工具，配合--coverage选项分析代码执行情况
# OBJDUMP   : 目标文件信息查看器，用于反汇编生成.lst文件，查看C/C++对应的汇编指令
# OBJCOPY   : 目标文件格式转换器，用于将ELF转为.bin/.hex等烧录格式（嵌入式常用）
# READELF   : ELF文件分析器，显示ELF格式文件的段信息、符号表等
# SIZE      : 段大小查看器，显示.text/.data/.bss段大小，评估Flash/RAM占用
# 
# Utility tools:
# ECHO  : 打印输出信息，如 "+++ compiling xxx"
# MAKE  : 构建工具自身，用于嵌套构建（$(MAKE) -C subdir）
# MKDIR : 创建目录，如 bin/、tmp/ 等
# RM    : 删除文件或目录，用于清理构建产物
# SED   : 流编辑器，用于文本处理（如格式化错误信息适配Visual Studio）


AR		= $(PATH_TOOLS_CC)ar
AS		= $(PATH_TOOLS_CC)gcc
CC		= $(PATH_TOOLS_CC)gcc
CL		= $(PATH_TOOLS_CC)gcc
NM		= $(PATH_TOOLS_CC)nm
GCOV	= $(PATH_TOOLS_CC)gcov
OBJDUMP	= $(PATH_TOOLS_CC)objdump   # 修正：原来是 OBJDUNO
OBJCOPY	= $(PATH_TOOLS_CC)objcopy
READELF	= $(PATH_TOOLS_CC)readelf
SIZE    = $(PATH_TOOLS_CC)size      # 新增：size 工具
CPPFILT = $(PATH_TOOLS_CC)c++filt   # 新增：用于 C++ 符号还原

ECHO	= $(PATH_TOOLS_UTIL)echo
MAKE	= $(PATH_TOOLS_UTIL)make
MKDIR	= $(PATH_TOOLS_UTIL)mkdir
RM		= $(PATH_TOOLS_UTIL)rm
SED     = $(PATH_TOOLS_UTIL)sed     # 新增：sed 工具


# ------------------------------------------------------------------------------
# Compiler flags for the target architecture
# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# Compiler flags for the target architecture
# ------------------------------------------------------------------------------
# GCCFLAGS : 适用于所有编译阶段（C、C++、汇编）的通用编译选项
#
# Standard and language options:
# -gdwarf-2                 : 生成 DWARF-2 格式的调试信息，用于 GDB 调试
# -g                        : 生成调试信息（包含符号表、行号等），便于调试
# -O2                       : 优化级别 2，在代码大小和执行速度之间取得平衡
# -fno-exceptions           : 禁用 C++ 异常处理，减少生成的代码体积
#
# Warning options (all warnings enabled):
# -Wall                     : 开启大多数常见警告
# -Wextra                   : 开启额外的、更详细的警告
# -pedantic                 : 严格遵循 ISO C/C++ 标准，对不符合标准的用法发出警告
# -Wmain                    : 检查 main 函数的声明是否正确
# -Wundef                   : 当使用未定义的宏时发出警告
# -Wsign-conversion         : 警告有符号和无符号类型之间的隐式转换
# -Wuninitialized           : 警告可能未初始化的变量
# -Wshadow                  : 警告变量名遮蔽（shadow）了外层作用域的同名变量
# -Wunreachable-code        : 警告永远不会执行的代码（如 return 后的语句）
# -Wswitch-default          : 警告 switch 语句中没有 default 分支
# -Wswitch                  : 警告 switch 语句中枚举类型缺少某些 case
# -Wcast-align              : 警告因为对齐要求而可能导致性能问题的强制类型转换
# -Wmissing-include-dirs    : 警告包含路径（-I）中不存在的目录
# -Winit-self               : 警告使用自身初始化的变量（如 int a = a;）
# -Wdouble-promotion        : 警告 float 类型隐式提升为 double 类型
# -Wunused-parameter        : 警告函数中未使用的参数
# -Wfloat-equal             : 警告浮点数之间的直接相等比较（可能因精度问题导致非预期结果）
#
# Optimization and code generation options:
# -ffunction-sections       : 将每个函数放入独立的段（section），便于链接时优化（配合 -Wl,--gc-sections 可删除未使用的函数）
# -fdata-sections           : 将每个数据项（变量）放入独立的段，便于链接时优化
# -ffat-lto-objects         : 在 LTO（链接时代码优化）时生成包含中间表示的对象文件
# -fverbose-asm             : 在生成的汇编代码中添加注释，提高可读性
#
# Macro definitions and includes:
# $(C_INCLUDES)             : 额外的头文件搜索路径（-I），在文件顶部定义
# $(C_DEFINES)              : 额外的宏定义（-D），在文件顶部定义

GCCFLAGS      = $(C_INCLUDES)                     \
                $(C_DEFINES)                      \
                -g                                \
                -Wall                             \
                -pedantic                         \
                -Wmain                            \
                -Wundef                           \
                -Wsign-conversion                 \
                -Wuninitialized                   \
                -Wshadow                          \
                -Wunreachable-code                \
                -Wswitch-default                  \
                -Wswitch                          \
                -Wcast-align                      \
                -Wmissing-include-dirs            \
                -Winit-self                       \
                -Wdouble-promotion                \
                -gdwarf-2                         \
                -fno-exceptions                   \
                -O2                               \
                -ffunction-sections               \
                -ffat-lto-objects                 \
                -fdata-sections                   \
                -fverbose-asm                     \
                -Wextra                           \
                -Wunused-parameter                \
                -Wfloat-equal

# ------------------------------------------------------------------------------
# C language specific compiler flags
# ------------------------------------------------------------------------------
# CFLAGS : 专门用于编译 C 语言源文件（.c）的选项
#          在 GCCFLAGS 的基础上，添加 C 语言特有的编译选项
#
# C language options:
# -x c                     : 强制指定语言为 C（即使文件扩展名不是 .c）
# -std=c99                 : 使用 C99 标准（支持变长数组、单行注释等特性）
# -Wunsuffixed-float-constants : 警告浮点常量没有后缀（如 3.14 应写作 3.14f）


CFLAGS        = $(GCCFLAGS)                       \
                -Wunsuffixed-float-constants      \
                -x c                              \
                -std=c99  

                
# ------------------------------------------------------------------------------
# Assembler specific compiler flags
# ------------------------------------------------------------------------------
# AFLAGS : 专门用于编译汇编语言源文件（.s/.S）的选项
#          在 GCCFLAGS 的基础上，添加汇编语言特有的编译选项
#
# Assembler language options:
# -x assembler              : 强制指定语言为汇编（即使文件扩展名不是 .s/.S）


AFLAGS        = $(GCCFLAGS)                       \
                -x assembler

# ------------------------------------------------------------------------------
# Linker specific flags
# ------------------------------------------------------------------------------
# LFLAGS : 专门用于链接阶段（将 .o 文件链接为可执行文件）的选项
#          在 GCCFLAGS 的基础上，添加链接器特有的选项
#
# Linker options:
# -x none                     : 禁用语言指定（不将输入文件视为任何特定编程语言）
# -Wl,--gc-sections           : 通过链接器（ld）删除未使用的段（section）


LFLAGS        = $(GCCFLAGS)                       \
                -x none                           \
                -Wl,--gc-sections

# ------------------------------------------------------------------------------
# Targets
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Main-Dependencies (app: all)
# ------------------------------------------------------------------------------       

.PHONY: all
all: clean_prj $(TRG) $(TRG)_nm.txt

# ------------------------------------------------------------------------------
# Main-Dependencies (app: rebuild)
# ------------------------------------------------------------------------------
.PHONY: rebuild
rebuild: clean $(TRG) $(TRG)_nm.txt

# ------------------------------------------------------------------------------
# clean project
# ------------------------------------------------------------------------------
.PHONY: clean_prj
clean_prj:
	@-$(ECHO)  +++ cleaning project
	@-$(RM) -rf $(PATH_BIN)  2> $(PATH_NUL)
	@-$(MKDIR) -p $(PATH_BIN)   # 修正：& 改为 $
	@-$(MKDIR) -p $(PATH_OBJ)
	@-$(MKDIR) -p $(PATH_ERR)
	@-$(MKDIR) -p $(PATH_LST)
	@-$(MKDIR) -p $(PATH_PRE)
	@-$(MKDIR) -p $(PATH_COV)

# ------------------------------------------------------------------------------
# clean all
# ------------------------------------------------------------------------------
.PHONY: clean
clean:
	@-$(ECHO)  +++ cleaning all
	@-$(RM) -rf $(PATH_TMP)  2> $(PATH_NUL)
	@-$(RM) -rf $(PATH_BIN)  2> $(PATH_NUL)
	@-$(MKDIR) -p $(PATH_BIN)
	@-$(MKDIR) -p $(PATH_OBJ)
	@-$(MKDIR) -p $(PATH_ERR)
	@-$(MKDIR) -p $(PATH_LST)
	@-$(MKDIR) -p $(PATH_PRE)
	@-$(MKDIR) -p $(PATH_COV)

# ------------------------------------------------------------------------------
# print the GNUmake version and the compiler version
# ------------------------------------------------------------------------------
.PHONY: version
version:

	@$(ECHO) GNUmake version:
	@$(MAKE) --version
	@$(ECHO) GCC version:
	@$(CL) -v

# ------------------------------------------------------------------------------
# Rules
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Link/locate application
# ------------------------------------------------------------------------------
# $(TRG) : 目标可执行文件（例如 bin/test_suite）
# 依赖    : $(FILES_O)（所有 .o 目标文件列表）
# 功能    : 将编译好的 .o 文件链接成最终的可执行文件，并生成调试辅助文件

$(TRG) : $(FILES_O)
# 打印链接开始提示信息
	@-$(ECHO) +++ linking application to generate: $(TRG)   # 修正：linkink -> linking
	
# 主链接命令：生成最终的可执行文件
# $(CL)      : 链接器（g++）
# $(LFLAGS)  : 链接器标志（包含通用选项和链接器特有选项）
# -L.        : 在当前目录搜索库文件
# -lc        : 链接标准 C 库（libc）
# $(PATH_OBJ)/*.o : 所有目标文件（位于 tmp/obj/ 目录）
# -Wl,-Map,$(TRG).map : 生成内存映射文件（分析内存布局）
# -o $(TRG)  : 指定输出可执行文件的路径和名称
	@-$(CL) $(LFLAGS) -L. -lc $(PATH_OBJ)/*.o -Wl,-Map,$(TRG).map -o $(TRG)
	
# 代码覆盖率版本的链接命令
# $(PATH_COV)/*.o : 所有带覆盖率插桩的目标文件（位于 tmp/cov/ 目录）
# --coverage  : 启用代码覆盖率分析支持（生成 .gcno/.gcda 文件）
# -o $(PATH_COV)/$(APP) : 输出到 tmp/cov/ 目录，命名为 test_review
	@-$(CL) $(LFLAGS) -L. -lc $(PATH_COV)/*.o --coverage -o $(PATH_COV)/$(APP)



# ------------------------------------------------------------------------------
# Parse the object files to obtain symbol information, and create a size summary
# ------------------------------------------------------------------------------
# $(TRG)_nm.txt : 符号表分析文件（例如 bin/test_review_nm.txt）
# 依赖          : $(TRG)（最终可执行文件）
# 功能          : 从可执行文件中提取符号信息，并生成三份分析报告

$(TRG)_nm.txt : $(TRG)
# 提示信息：正在使用 nm 解析符号
	@-$(ECHO) +++ parsing symbols with nm to generate: $(TRG)_nm.txt
	
# 命令1：生成标准符号表
# $(NM)          : 符号查看器（nm）
# --numeric-sort : 按地址数值排序（而非默认的字母顺序）
# --print-size   : 同时打印每个符号占用的字节数
# $(TRG)         : 输入的可执行文件
# > $(TRG)_nm.txt : 输出到 test_review_nm.txt
	@-$(NM) --numeric-sort --print-size $(TRG) > $(TRG)_nm.txt
	
# 提示信息：正在使用 c++filt 进行符号名称还原
	@-$(ECHO) +++ demangling symbols with c++filt to generate: $(TRG)_cppfilt.txt
	
# 命令2：生成可读性更强的符号表（C++ 名称还原）
# | $(CPPFILT)    : 通过管道将 nm 的输出传递给 c++filt 工具
#                   c++filt 将 C++ 修饰名还原为人类可读的原始函数名
# > $(TRG)_cppfilt.txt : 输出到 test_review_cppfilt.txt
	@-$(NM) --numeric-sort --print-size $(TRG) | $(CPPFILT) > $(TRG)_cppfilt.txt
	
# 提示信息：正在使用 size 生成大小汇总表
	@-$(ECHO) +++ creating size summary table with size to generate: $(TRG)_size.txt
	
# 命令3：生成段大小总结报告
# $(SIZE)        : 段大小查看器（size）
# -A             : 以 SysV 风格输出（显示每个段的具体名称和大小）
# -t             : 在最后输出所有段的总和（Totals）
# $(TRG)         : 输入的可执行文件
# > $(TRG)_size.txt : 输出到 test_review_size.txt
	@-$(SIZE) -A -t $(TRG) > $(TRG)_size.txt

# ------------------------------------------------------------------------------
# Compile C source files
# ------------------------------------------------------------------------------
# %.o : %.c : 模式规则，将每个 .c 源文件编译为 .o 目标文件
# 功能      : 编译源文件并生成预处理文件、错误日志、反汇编列表和依赖文件

%.o : %.c
# 打印编译提示信息，$< 表示当前源文件名
	@$(ECHO) +++ compile: $<
	
# ---- 命令1：预处理 ----
# 执行预处理，生成 .pre 文件（查看宏展开后的代码）
# $(CL)      : 编译器（g++，也可用于 C 源文件的预处理）
# $(CFLAGS)  : C 语言编译选项
# $<         : 当前源文件（.c）
# -E         : 只进行预处理，不编译
# -o $(PATH_PRE)/$(basename $(@F)).pre : 输出到 tmp/pre/ 目录
	@-$(CL) $(CFLAGS) $< -E -o $(PATH_PRE)/$(basename $(@F)).pre
	
# ---- 命令2：编译并生成错误日志 ----
# 编译源文件，生成 .o 目标文件，并将错误信息重定向到 .err 文件
# $(CC)      : C 编译器（gcc）
# $(CFLAGS)  : C 语言编译选项
# -c         : 只编译不链接
# 2> $(PATH_ERR)/$(basename $(@F)).err : 错误输出重定向到 tmp/err/ 目录
	@-$(CC) $(CFLAGS) $< -c -o $(PATH_OBJ)/$(basename $(@F)).o 2> $(PATH_ERR)/$(basename $(@F)).err
	
# ---- 命令3：格式化错误信息 ----
# 使用 sed 将错误格式转换为 Visual Studio 友好格式（file.h(行号) : error）
# -e 's|.h:\([0-9]*\),|.h(\1) :|' : 将 "file.h:行号," 转为 "file.h(行号) :"
# -e 's|:\([0-9]*\):|(\1) :|'      : 将 ":行号:" 转为 "(行号) :"
# 输入：tmp/err/文件名.err，输出：直接修改该文件
	@-$(SED) -e 's|.h:\([0-9]*\),|.h(\1) :|' -e 's|:\([0-9]*\):|(\1) :|' $(PATH_ERR)/$(basename $(@F)).err
	
# ---- 命令4：生成反汇编列表 ----
# 使用 objdump 从 .o 文件生成汇编列表文件
# $(OBJDUMP) : 目标文件分析器
# -S          : 反汇编并显示对应的源代码（相当于 --disassemble --line-numbers）
# > $(PATH_LST)/$(basename $(@F)).lst : 输出到 tmp/lst/ 目录
	@-$(OBJDUMP) -S $(PATH_OBJ)/$(basename $(@F)).o > $(PATH_LST)/$(basename $(@F)).lst
	
# ---- 命令5：生成依赖文件 ----
# 使用 -MM 选项生成 Makefile 风格的依赖关系（头文件依赖）
# $(CC)      : C 编译器（gcc）
# -MM        : 生成依赖规则，不包含系统头文件
# > $(PATH_OBJ)/$(basename $(@F)).d : 输出到 tmp/obj/ 目录
	@-$(CC) $(CFLAGS) $< -MM > $(PATH_OBJ)/$(basename $(@F)).d

# ---- 覆盖率版本 ----
# 编译生成用于代码覆盖率分析的 .o 文件
# $(CC)          : C 编译器（gcc）
# $(CFLAGS)      : C 语言编译选项
# -O0            : 禁用所有优化，确保覆盖率分析的准确性（优化可能导致代码行被合并或重排）
# --coverage     : 在编译时插入覆盖率检测的"探针"，配合链接时的 --coverage 选项使用
# $<             : 当前源文件（.c）
# -c             : 只编译不链接
# -o $(PATH_COV)/$(basename $(@F)).o : 将生成的 .o 文件单独存放在 tmp/cov/ 目录，与常规编译产物隔离
# 2> $(PATH_NUL) : 将错误输出重定向到黑洞（/dev/null），保持构建输出简洁
	@-$(CC) $(CFLAGS) -O0 --coverage $< -c -o $(PATH_COV)/$(basename $(@F)).o 2> $(PATH_NUL)

# ------------------------------------------------------------------------------
# Include dependency files (自动依赖追踪)
# ------------------------------------------------------------------------------
-include $(PATH_OBJ)/*.d
